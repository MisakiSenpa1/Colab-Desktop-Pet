# 统一文本换行符为 LF，避免 Windows 下 LF/CRLF 混用产生整文件噪音 diff
* text=auto eol=lf

# Windows 批处理与 PowerShell 脚本显式使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制资产不做文本换行转换
*.webp binary
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.wav binary
*.mp3 binary
*.zip binary
*.exe binary
